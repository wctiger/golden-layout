{
  "name": "golden-layout",
  "version": "2.0.0-alpha.0",
  "description": "A React 18+ docking layout manager: rows, columns and tabbed stacks with drag and drop",
  "keywords": [
    "docking",
    "layout",
    "layout manager",
    "react",
    "tabs"
  ],
  "homepage": "https://github.com/wctiger/golden-layout#readme",
  "bugs": {
    "url": "https://github.com/wctiger/golden-layout/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wctiger/golden-layout.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/golden-layout.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp dev examples/trading",
    "dev:simple": "vp dev examples/simple",
    "build": "vp pack",
    "build:examples": "vp build examples/trading --base ./ --outDir ../dist --emptyOutDir && vp build examples/simple --base ./ --outDir ../dist/simple --emptyOutDir",
    "test": "vp test run",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "5.1.0",
    "dockview-react": "8.9.0",
    "playwright": "1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite-plus": "^1.6.0",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=22.18"
  }
}
